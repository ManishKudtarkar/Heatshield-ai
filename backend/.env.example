# Application
APP_NAME=HeatShield AI API
APP_VERSION=1.0.0

# AWS Bedrock
AWS_REGION=ap-south-1
BEDROCK_MODEL_ID=apac.amazon.nova-lite-v1:0

# Logging
LOG_LEVEL=INFO

# API documentation
API_DOCS_ENABLED=true

# Local development frontend origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
